# Customer Feedback Intelligence (CFI) Environment Configuration

# Django
DJANGO_SECRET_KEY=change-me-in-production-insecure-secret-key-32chars-min
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (PostgreSQL for Production, SQLite fallback for Development if DB_NAME is empty)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=cfi_db
DB_USER=cfi_user
DB_PASSWORD=cfi_secure_password
DB_HOST=localhost
DB_PORT=5432

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set to True for synchronous local testing or when Redis is unavailable
CELERY_TASK_ALWAYS_EAGER=False

# Data Ingestion Limits
MAX_UPLOAD_SIZE_MB=25
MAX_CSV_ROWS=100000
INGESTION_BATCH_SIZE=1000

# Security (Production)
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
